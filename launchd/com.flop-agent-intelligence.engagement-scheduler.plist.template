<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.flop-agent-intelligence.engagement-scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>&lt;IMMUTABLE_RUNTIME_GENERATION&gt;/python/bin/python3</string>
    <string>-I</string>
    <string>&lt;APPROVED_REPOSITORY_ROOT&gt;/scripts/engagement_scheduler_launcher.py</string>
    <string>--expected-revision</string>
    <string>&lt;APPROVED_GIT_REVISION&gt;</string>
    <string>--runtime-root</string>
    <string>&lt;PRIVATE_RUNTIME_ROOT&gt;</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
