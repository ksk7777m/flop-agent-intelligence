{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/technocore-transport-semantics.v1.json",
  "title": "Technocore 0.13.0 Transport Semantics V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","content_label","operation","request_completion","http_status","response_schema","content_completeness","content_truncated","dropped_count","effective_limit","freshness","response_metadata_observed","cache_evidence_observed","age_seconds","retry_disposition","new_connection_required","reconciliation_required","new_authorization_required","replay_journal_required","side_effect_certainty","nonce_outcome","body_sha256","body_bytes","observed_at","documented_version","runtime_compatibility","ready_to_act","authorized_to_act","live_action_enabled","policy_version"],
  "properties": {
    "schema": {"const": "technocore-transport-semantics-v1"},
    "status": {"const": "DESCRIPTIVE_ONLY"},
    "content_label": {"const": "UNTRUSTED_CONTENT"},
    "operation": {"enum": ["MCP_LIST_NOTES","POST_UPLOAD","CONDITIONAL_NOTE_WRITE","NOTE_READ"]},
    "request_completion": {"enum": ["COMPLETED","UNKNOWN"]},
    "http_status": {"type": ["integer","null"], "minimum": 100, "maximum": 599},
    "response_schema": {"enum": ["VALIDATED","NOT_VALIDATED"]},
    "content_completeness": {"enum": ["COMPLETE_BODY_ONLY","PARTIAL","UNKNOWN"]},
    "content_truncated": {"type": ["boolean","null"]},
    "dropped_count": {"type": ["integer","null"], "minimum": 0},
    "effective_limit": {"type": ["integer","null"], "minimum": 1, "maximum": 200},
    "freshness": {"enum": ["UNKNOWN","STALE"]},
    "response_metadata_observed": {"type": "boolean"},
    "cache_evidence_observed": {"type": "boolean"},
    "age_seconds": {"type": ["integer","null"], "minimum": 0},
    "retry_disposition": {"enum": ["DO_NOT_RETRY","RECONCILIATION_REQUIRED","ELIGIBLE_AFTER_NEW_AUTHORIZATION"]},
    "new_connection_required": {"type": "boolean"},
    "reconciliation_required": {"type": "boolean"},
    "new_authorization_required": {"type": "boolean"},
    "replay_journal_required": {"type": "boolean"},
    "side_effect_certainty": {"enum": ["NOT_APPLICABLE","NOT_PROVEN","OUTCOME_UNKNOWN"]},
    "nonce_outcome": {"enum": ["NOT_APPLICABLE","UNKNOWN"]},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body_bytes": {"type": "integer", "minimum": 0, "maximum": 2097152},
    "observed_at": {"type": "string", "format": "date-time"},
    "documented_version": {"const": "0.13.0"},
    "runtime_compatibility": {"const": "COMPATIBILITY_REVIEW_REQUIRED"},
    "ready_to_act": {"const": false},
    "authorized_to_act": {"const": false},
    "live_action_enabled": {"const": false},
    "policy_version": {"const": "technocore-0130-transport-policy-v1"}
  },
  "allOf": [
    {"if": {"properties": {"http_status": {"const": 408}}, "required": ["http_status"]}, "then": {"properties": {"request_completion": {"const": "UNKNOWN"}, "retry_disposition": {"const": "RECONCILIATION_REQUIRED"}, "new_connection_required": {"const": true}, "side_effect_certainty": {"const": "OUTCOME_UNKNOWN"}}}},
    {"if": {"properties": {"content_truncated": {"const": true}}, "required": ["content_truncated"]}, "then": {"properties": {"content_completeness": {"const": "PARTIAL"}, "dropped_count": {"type": "integer", "minimum": 1}}}},
    {"if": {"properties": {"operation": {"const": "MCP_LIST_NOTES"}}, "required": ["operation"]}, "then": {"properties": {"http_status": {"const": null}, "content_completeness": {"enum": ["PARTIAL","UNKNOWN"]}, "freshness": {"const": "UNKNOWN"}}}}
  ]
}
