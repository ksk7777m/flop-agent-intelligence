{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/runtime-capability.v1.json",
  "title": "FLOP Runtime Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "implementation_readiness", "live_runtime_readiness",
    "overall_state", "ready_to_act", "authorized_to_act",
    "blocking_reasons", "domains"
  ],
  "properties": {
    "schema": {"const": "flop-runtime-capability-manifest-v1"},
    "implementation_readiness": {"enum": ["IMPLEMENTATION_READY", "BLOCKED"]},
    "live_runtime_readiness": {"enum": ["BLOCKED", "IMPLEMENTATION_READY", "OBSERVATION_REQUIRED", "HUMAN_REVIEW_REQUIRED", "ACTION_READY", "AUTHORIZED"]},
    "overall_state": {"enum": ["BLOCKED", "IMPLEMENTATION_READY", "OBSERVATION_REQUIRED", "HUMAN_REVIEW_REQUIRED", "ACTION_READY", "AUTHORIZED"]},
    "ready_to_act": {"type": "boolean"},
    "authorized_to_act": {"type": "boolean"},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["IDENTITY", "TECHNOCORE", "EXPORT_EVIDENCE", "FAUCET", "TESTNET_NETWORK", "INFERENCE", "SETTLEMENT_RAIL", "EVIDENCE_DURABILITY"],
      "properties": {
        "IDENTITY": {"$ref": "#/$defs/domain"},
        "TECHNOCORE": {"$ref": "#/$defs/domain"},
        "EXPORT_EVIDENCE": {"$ref": "#/$defs/domain"},
        "FAUCET": {"$ref": "#/$defs/domain"},
        "TESTNET_NETWORK": {"$ref": "#/$defs/domain"},
        "INFERENCE": {"$ref": "#/$defs/domain"},
        "SETTLEMENT_RAIL": {"$ref": "#/$defs/domain"},
        "EVIDENCE_DURABILITY": {"$ref": "#/$defs/domain"}
      }
    }
  },
  "$defs": {
    "domain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "domain", "implementation_status", "documented_status", "runtime_status", "source_id", "observed_at", "observation_hash", "policy_version", "verifier_revision", "blocking_reasons", "ready_to_act", "authorized_to_act"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z0-9_.-]{1,128}$"},
        "domain": {"type": "string"},
        "implementation_status": {"type": "string"},
        "documented_status": {"type": "string"},
        "runtime_status": {"type": "string"},
        "source_id": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "observation_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "policy_version": {"type": "string"},
        "verifier_revision": {"type": "string"},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "ready_to_act": {"type": "boolean"},
        "authorized_to_act": {"type": "boolean"}
      }
    }
  }
}
