{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ksk7777m.github.io/flop-agent-intelligence/schemas/production-reobservation-handoff.v1.json",
  "title":"Production Human Reobservation Authorization Ceremony V1",
  "oneOf":[
    {"$ref":"#/$defs/review"},{"$ref":"#/$defs/checklist"},{"$ref":"#/$defs/status"}
  ],
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "review":{
      "type":"object","additionalProperties":false,
      "required":["schema","record_type","record_id","status","reviewed_at","reviewed_main_sha","runner_implementation_id","plan_id","predicate_policy","predicate_policy_hash","observation_policy","source_set_id","source_order_hash","expected_generation","journal_id","journal_identity_domain","journal_schema","checklist_revision","operation","method","retry_count","redirects_allowed","fallback_enabled","alternate_url_enabled","timeout_policy_id","production_permit_issuer","production_evidence_issuer","production_execution","compatibility","retention_policy","review_window_policy","rollback_anchor_policy","operator_identity_policy","separation_of_duties_policy","ready_to_act","authorized_to_act","executable","live_get_count"],
      "properties":{
        "schema":{"const":"production-reobservation-handoff-v1"},"record_type":{"const":"AUTHORIZATION_REVIEW"},"record_id":{"$ref":"#/$defs/hash"},
        "status":{"const":"REVIEWED_DESCRIPTIVE_ONLY"},"reviewed_at":{"type":"string","format":"date-time"},"reviewed_main_sha":{"const":"fc7df45d032b2a39a652e176581e392ae6c455a0"},
        "runner_implementation_id":{"$ref":"#/$defs/hash"},"plan_id":{"$ref":"#/$defs/hash"},"predicate_policy":{"const":"technocore-runtime-predicates-v2"},"predicate_policy_hash":{"$ref":"#/$defs/hash"},
        "observation_policy":{"const":"technocore-runtime-readonly-observation-v1"},"source_set_id":{"const":"technocore-runtime-fixed-source-set-v1"},"source_order_hash":{"$ref":"#/$defs/hash"},"expected_generation":{"const":0},
        "journal_id":{"$ref":"#/$defs/hash"},"journal_identity_domain":{"const":"FLOP_DURABLE_OBSERVATION_JOURNAL_V1"},"journal_schema":{"const":"durable-observation-attempt-journal-v1"},"checklist_revision":{"const":"production-reobservation-activation-checklist-v1"},
        "operation":{"const":"READ_ONLY_REOBSERVATION"},"method":{"const":"GET"},"retry_count":{"const":0},"redirects_allowed":{"const":false},"fallback_enabled":{"const":false},"alternate_url_enabled":{"const":false},"timeout_policy_id":{"$ref":"#/$defs/hash"},
        "production_permit_issuer":{"const":"ABSENT"},"production_evidence_issuer":{"const":"ABSENT"},"production_execution":{"const":"UNREACHABLE"},"compatibility":{"const":"COMPATIBILITY_REVIEW_REQUIRED"},
        "retention_policy":{"const":"POLICY_REQUIRED"},"review_window_policy":{"const":"POLICY_REQUIRED"},"rollback_anchor_policy":{"const":"POLICY_REQUIRED"},"operator_identity_policy":{"const":"POLICY_REQUIRED"},"separation_of_duties_policy":{"const":"POLICY_REQUIRED"},
        "ready_to_act":{"const":false},"authorized_to_act":{"const":false},"executable":{"const":false},"live_get_count":{"const":0}
      }
    },
    "checkItem":{
      "type":"object","additionalProperties":false,"required":["ordinal","check_id","status","satisfied"],
      "properties":{"ordinal":{"type":"integer","minimum":0,"maximum":17},"check_id":{"type":"string","pattern":"^[A-Z0-9_]+$"},"status":{"enum":["PASS","VERIFICATION_REQUIRED","POLICY_REQUIRED","AUTHORIZATION_REQUIRED"]},"satisfied":{"type":"boolean"}}
    },
    "checklist":{
      "type":"object","additionalProperties":false,
      "required":["schema","record_type","checklist_id","review_record_id","checklist_revision","reviewed_main_sha","plan_id","timeout_policy_id","items","activation_status","unsatisfied_count","production_permit_issuer","production_execution","ready_to_act","authorized_to_act","live_get_count"],
      "properties":{
        "schema":{"const":"production-reobservation-handoff-v1"},"record_type":{"const":"ACTIVATION_CHECKLIST"},"checklist_id":{"$ref":"#/$defs/hash"},"review_record_id":{"$ref":"#/$defs/hash"},"checklist_revision":{"const":"production-reobservation-activation-checklist-v1"},
        "reviewed_main_sha":{"const":"fc7df45d032b2a39a652e176581e392ae6c455a0"},"plan_id":{"$ref":"#/$defs/hash"},"timeout_policy_id":{"$ref":"#/$defs/hash"},"items":{"type":"array","minItems":18,"maxItems":18,"items":{"$ref":"#/$defs/checkItem"}},
        "activation_status":{"const":"BLOCKED"},"unsatisfied_count":{"type":"integer","minimum":1,"maximum":18},"production_permit_issuer":{"const":"ABSENT"},"production_execution":{"const":"UNREACHABLE"},"ready_to_act":{"const":false},"authorized_to_act":{"const":false},"live_get_count":{"const":0}
      }
    },
    "status":{
      "type":"object","additionalProperties":false,
      "required":["schema","record_type","handoff_state","review_record_id","review_currentness","activation_status","production_permit_issuer","production_evidence_issuer","production_execute_api","cli_entry_point","scheduler","live_execution","compatibility","automatic_retry_allowed","automatic_resume_allowed","ready_to_act","authorized_to_act","live_action_enabled","live_get_count"],
      "properties":{
        "schema":{"const":"production-reobservation-handoff-v1"},"record_type":{"const":"HANDOFF_STATUS"},"handoff_state":{"const":"ACTIVATION_REVIEW_REQUIRED"},"review_record_id":{"$ref":"#/$defs/hash"},"review_currentness":{"const":"CURRENTNESS_UNKNOWN"},"activation_status":{"const":"BLOCKED"},
        "production_permit_issuer":{"const":"ABSENT"},"production_evidence_issuer":{"const":"ABSENT"},"production_execute_api":{"const":"ABSENT"},"cli_entry_point":{"const":"ABSENT"},"scheduler":{"const":"ABSENT"},"live_execution":{"const":"UNREACHABLE"},"compatibility":{"const":"COMPATIBILITY_REVIEW_REQUIRED"},
        "automatic_retry_allowed":{"const":false},"automatic_resume_allowed":{"const":false},"ready_to_act":{"const":false},"authorized_to_act":{"const":false},"live_action_enabled":{"const":false},"live_get_count":{"const":0}
      }
    }
  }
}
