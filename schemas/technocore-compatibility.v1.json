{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/technocore-compatibility.v1.json",
  "title": "Technocore Compatibility Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "reviewed_at", "reviewed_technocore_agent_version",
    "source_evidence", "semantic_invariants", "capability_evidence",
    "deployment_observations", "observation_policy_binding", "freshness",
    "flop_specification_authority", "tclk_accept_conformance"
  ],
  "properties": {
    "schema": {"const": "technocore-compatibility-manifest-v1"},
    "status": {"const": "COMPATIBILITY_REVIEW_REQUIRED"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_technocore_agent_version": {"type": "string", "minLength": 1},
    "source_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "local_artifact", "classification", "source_revision"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "local_artifact": {"const": "docs/TECHNOCORE_0130_TRANSPORT_SEMANTICS.md"},
        "classification": {"const": "LOCALLY_REVIEWED_OFFICIAL_RELEASE_CONTRACT"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "semantic_invariants": {
      "type": "object", "additionalProperties": false,
      "required": ["room", "kv", "transport", "mailbox", "did_signature", "presence"],
      "properties": {
        "room": {"$ref": "#/$defs/nonEmptyStrings"},
        "kv": {"$ref": "#/$defs/nonEmptyStrings"},
        "transport": {"$ref": "#/$defs/nonEmptyStrings"},
        "mailbox": {"$ref": "#/$defs/nonEmptyStrings"},
        "did_signature": {"$ref": "#/$defs/nonEmptyStrings"},
        "presence": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "capability_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["documented", "runtime_observed"],
      "properties": {
        "documented": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "capabilities"],
          "properties": {
            "kind": {"const": "DOCUMENTED_CAPABILITY"},
            "capabilities": {"$ref": "#/$defs/nonEmptyStrings"}
          }
        },
        "runtime_observed": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "status", "capabilities"],
          "properties": {
            "kind": {"const": "RUNTIME_OBSERVED_CAPABILITY"},
            "status": {"const": "ONE_SHOT_PARTIAL_SEMANTIC_OBSERVATION"},
            "capabilities": {
              "type": "array", "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "deployment_observations": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "capacity", "counts", "limits", "deployment_version", "observed_at"],
      "properties": {
        "status": {"const": "ONE_SHOT_READ_ONLY_OBSERVATION"},
        "capacity": {"type": ["integer", "null"]},
        "counts": {"type": ["object", "null"]},
        "limits": {"type": ["object", "null"]},
        "deployment_version": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "observation_policy_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_predicate_policy_revision", "current_predicate_policy_revision", "llms_result", "reobservation_status", "source_set_complete", "evidence_retention", "currentness", "retention_policy"],
      "properties": {
        "observed_predicate_policy_revision": {"const": "technocore-runtime-predicates-v1"},
        "current_predicate_policy_revision": {"const": "technocore-runtime-predicates-v2"},
        "llms_result": {"const": "OBSERVED_UNDER_SUPERSEDED_POLICY"},
        "reobservation_status": {"const": "REOBSERVATION_REQUIRED"},
        "source_set_complete": {"const": false},
        "evidence_retention": {"const": "RETAINED"},
        "currentness": {"const": "CURRENTNESS_UNKNOWN"},
        "retention_policy": {"const": "RETENTION_POLICY_REQUIRED"}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "REVIEW_REQUIRED"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "flop_specification_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "artifact", "status", "yellow_paper_source_type", "yellow_paper_identity", "yellow_paper_content", "ratification", "scoring", "action"],
      "properties": {
        "schema": {"const": "flop-spec-authority-v1"},
        "artifact": {"const": "data/spec_authority.json"},
        "status": {"const": "SOURCE_EVIDENCE_REQUIRED"},
        "yellow_paper_source_type": {"const": "REGISTERED"},
        "yellow_paper_identity": {"const": "UNVERIFIED"},
        "yellow_paper_content": {"const": "NOT_ATTESTED"},
        "ratification": {"const": "RATIFICATION_UNRESOLVED"},
        "scoring": {"const": "UNRESOLVED"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "tclk_accept_conformance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "artifact", "official_schema", "historical_classification", "field_report", "action"],
      "properties": {
        "schema": {"const": "tclk-accept-conformance-package-v1"},
        "artifact": {"const": "data/tclk_accept_conformance.json"},
        "official_schema": {"const": "OFFICIAL_SCHEMA_REVISION_REQUIRED"},
        "historical_classification": {"const": "HISTORICAL_CLASSIFICATION_UNRESOLVED"},
        "field_report": {"const": "UNRATIFIED"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    }
  }
}
