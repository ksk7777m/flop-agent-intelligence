{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/technocore-compatibility.v1.json",
  "title": "Technocore Compatibility Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "reviewed_at", "reviewed_technocore_agent_version",
    "source_evidence", "semantic_invariants", "capability_evidence",
    "deployment_observations", "observation_policy_binding", "freshness",
    "flop_specification_authority", "tclk_accept_conformance",
    "tclk_official_schema_evidence", "offline_tclk_accept_preflight", "tclk_transcript_boundary",
    "tclk_offer_global_winner_boundary", "tclk_offer_wide_evidence", "tclk_source_attestation", "tclk_offer_wide_completeness", "tclk_authenticated_winner", "flop_testnet_readiness"
  ],
  "properties": {
    "schema": {"const": "technocore-compatibility-manifest-v1"},
    "status": {"const": "COMPATIBILITY_REVIEW_REQUIRED"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_technocore_agent_version": {"type": "string", "minLength": 1},
    "source_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "local_artifact", "classification", "source_revision"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "local_artifact": {"const": "docs/TECHNOCORE_0130_TRANSPORT_SEMANTICS.md"},
        "classification": {"const": "LOCALLY_REVIEWED_OFFICIAL_RELEASE_CONTRACT"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "semantic_invariants": {
      "type": "object", "additionalProperties": false,
      "required": ["room", "kv", "transport", "mailbox", "did_signature", "presence"],
      "properties": {
        "room": {"$ref": "#/$defs/nonEmptyStrings"},
        "kv": {"$ref": "#/$defs/nonEmptyStrings"},
        "transport": {"$ref": "#/$defs/nonEmptyStrings"},
        "mailbox": {"$ref": "#/$defs/nonEmptyStrings"},
        "did_signature": {"$ref": "#/$defs/nonEmptyStrings"},
        "presence": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "capability_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["documented", "runtime_observed"],
      "properties": {
        "documented": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "capabilities"],
          "properties": {
            "kind": {"const": "DOCUMENTED_CAPABILITY"},
            "capabilities": {"$ref": "#/$defs/nonEmptyStrings"}
          }
        },
        "runtime_observed": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "status", "capabilities"],
          "properties": {
            "kind": {"const": "RUNTIME_OBSERVED_CAPABILITY"},
            "status": {"const": "ONE_SHOT_PARTIAL_SEMANTIC_OBSERVATION"},
            "capabilities": {
              "type": "array", "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "deployment_observations": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "capacity", "counts", "limits", "deployment_version", "observed_at"],
      "properties": {
        "status": {"const": "ONE_SHOT_READ_ONLY_OBSERVATION"},
        "capacity": {"type": ["integer", "null"]},
        "counts": {"type": ["object", "null"]},
        "limits": {"type": ["object", "null"]},
        "deployment_version": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "observation_policy_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_predicate_policy_revision", "current_predicate_policy_revision", "llms_result", "reobservation_status", "source_set_complete", "evidence_retention", "currentness", "retention_policy"],
      "properties": {
        "observed_predicate_policy_revision": {"const": "technocore-runtime-predicates-v1"},
        "current_predicate_policy_revision": {"const": "technocore-runtime-predicates-v2"},
        "llms_result": {"const": "OBSERVED_UNDER_SUPERSEDED_POLICY"},
        "reobservation_status": {"const": "REOBSERVATION_REQUIRED"},
        "source_set_complete": {"const": false},
        "evidence_retention": {"const": "RETAINED"},
        "currentness": {"const": "CURRENTNESS_UNKNOWN"},
        "retention_policy": {"const": "RETENTION_POLICY_REQUIRED"}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "REVIEW_REQUIRED"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "flop_specification_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "artifact", "status", "yellow_paper_source_type", "yellow_paper_identity", "yellow_paper_content", "ratification", "scoring", "action"],
      "properties": {
        "schema": {"const": "flop-spec-authority-v1"},
        "artifact": {"const": "data/spec_authority.json"},
        "status": {"const": "SOURCE_EVIDENCE_REQUIRED"},
        "yellow_paper_source_type": {"const": "REGISTERED"},
        "yellow_paper_identity": {"const": "UNVERIFIED"},
        "yellow_paper_content": {"const": "NOT_ATTESTED"},
        "ratification": {"const": "RATIFICATION_UNRESOLVED"},
        "scoring": {"const": "UNRESOLVED"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "tclk_accept_conformance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "artifact", "official_schema", "official_conformance", "local_safety_profile", "historical_classification", "field_report", "action"],
      "properties": {
        "schema": {"const": "tclk-accept-conformance-package-v1"},
        "artifact": {"const": "data/tclk_accept_conformance.json"},
        "official_schema": {"const": "OFFICIAL_SCHEMA_REVISION_REQUIRED"},
        "official_conformance": {"const": "OFFICIAL_SCHEMA_CONFORMANCE_UNKNOWN"},
        "local_safety_profile": {"const": "TCLK_ACCEPT_LOCAL_SAFETY_PROFILE_V1"},
        "historical_classification": {"const": "HISTORICAL_CLASSIFICATION_UNRESOLVED"},
        "field_report": {"const": "UNRATIFIED"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "tclk_official_schema_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "artifact", "official_schema", "required_contract_policy", "contract_derivation", "local_profile_comparison", "historical_reclassification", "action"],
      "properties": {
        "schema": {"const": "tclk-official-schema-evidence-v1"},
        "artifact": {"const": "data/tclk_official_schema_evidence.json"},
        "official_schema": {"const": "OFFICIAL_SCHEMA_CONFORMANCE_POLICY_PINNED"},
        "required_contract_policy": {"const": "REQUIRED_CONTRACT_POLICY_ATTESTED"},
        "contract_derivation": {"const": "CONTRACT_DERIVATION_SPEC_PINNED"},
        "local_profile_comparison": {"const": "SPEC_DRIFT"},
        "historical_reclassification": {"const": "BLOCKED"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "offline_tclk_accept_preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "policy", "classification", "official_schema", "contract_derivation", "network", "side_effect", "authority", "action"],
      "properties": {
        "schema": {"const": "offline-tclk-accept-preflight-v1"},
        "policy": {"const": "offline-tclk-accept-preflight-policy-v1"},
        "classification": {"const": "SAFE_PURE_VALIDATOR"},
        "official_schema": {"const": "PINNED_EXACT_COMMIT_OFFLINE"},
        "contract_derivation": {"const": "INDEPENDENT_RECOMPUTATION_GOLDEN_VECTOR_MATCHED"},
        "network": {"const": "NONE"},
        "side_effect": {"const": "NONE"},
        "authority": {"const": "NONE"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "tclk_transcript_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "policy", "classification", "signed_scope", "venue_metadata", "completeness", "replay", "network", "side_effect", "action"],
      "properties": {
        "schema": {"const": "tclk-transcript-completeness-boundary-v1"},
        "policy": {"const": "tclk-transcript-boundary-policy-v1"},
        "classification": {"const": "SAFE_PURE_VALIDATOR"},
        "signed_scope": {"const": "ROOM_NONCE_TEXT"},
        "venue_metadata": {"const": "SEQ_TS_GENERATION_UNSIGNED_UNTRUSTED"},
        "completeness": {"const": "FAIL_CLOSED"},
        "replay": {"const": "EVIDENCE_REQUIRED"},
        "network": {"const": "NONE"}, "side_effect": {"const": "NONE"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "tclk_offer_global_winner_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "policy", "classification", "winner", "race_loss", "venue_ordering", "field_report_currentness", "network", "side_effect", "action"],
      "properties": {
        "schema": {"const": "tclk-offer-global-winner-boundary-v1"},
        "policy": {"const": "tclk-offer-global-winner-policy-v1"},
        "classification": {"const": "SAFE_PURE_VALIDATOR"},
        "winner": {"const": "GLOBAL_WINNER_UNRESOLVED"},
        "race_loss": {"const": "CANDIDATE_ONLY"},
        "venue_ordering": {"const": "AUTHENTICITY_UNKNOWN"},
        "field_report_currentness": {"const": "CURRENTNESS_NOT_CONFIRMED"},
        "network": {"const": "NONE"}, "side_effect": {"const": "NONE"},
        "action": {"const": "NO_LIVE_ACTION"}
      }
    },
    "tclk_offer_wide_evidence": {
      "type":"object","additionalProperties":false,
      "required":["schema","classification","source_authenticity","completeness","winner","network","action"],
      "properties":{"schema":{"const":"tclk-offer-wide-evidence-v1"},"classification":{"const":"SAFE_PURE_VALIDATOR"},"source_authenticity":{"const":"UNKNOWN"},"completeness":{"const":"COMPLETENESS_NOT_ESTABLISHED"},"winner":{"const":"GLOBAL_WINNER_UNRESOLVED"},"network":{"const":"NONE"},"action":{"const":"NO_LIVE_ACTION"}}
    },
    "tclk_source_attestation": {
      "type":"object","additionalProperties":false,
      "required":["schema","classification","authority_manifest","source_authenticity","completeness","winner","network","action"],
      "properties":{"schema":{"const":"tclk-source-attestation-verification-v1"},"classification":{"const":"SAFE_PURE_VALIDATOR"},"authority_manifest":{"const":"LOCAL_PUBLIC_KEYS_ONLY"},"source_authenticity":{"const":"FAIL_CLOSED"},"completeness":{"const":"COMPLETENESS_NOT_ESTABLISHED"},"winner":{"const":"GLOBAL_WINNER_UNRESOLVED"},"network":{"const":"NONE"},"action":{"const":"NO_LIVE_ACTION"}}
    },
    "tclk_offer_wide_completeness": {
      "type":"object","additionalProperties":false,
      "required":["schema","classification","source_authority","completeness","winner","network","action"],
      "properties":{"schema":{"const":"tclk-offer-wide-completeness-v1"},"classification":{"const":"SAFE_PURE_VALIDATOR"},"source_authority":{"const":"SEALED_ATTESTATION_REQUIRED"},"completeness":{"const":"CONDITIONALLY_ISSUABLE"},"winner":{"const":"GLOBAL_WINNER_UNRESOLVED"},"network":{"const":"NONE"},"action":{"const":"NO_LIVE_ACTION"}}
    },
    "tclk_authenticated_winner": {
      "type":"object","additionalProperties":false,"required":["schema","classification","authority","winner","race_loss","network","action"],
      "properties":{"schema":{"const":"tclk-authenticated-winner-v1"},"classification":{"const":"SAFE_PURE_VALIDATOR"},"authority":{"const":"PINNED_WINNER_AUTHORITY_REQUIRED"},"winner":{"const":"CONDITIONALLY_ISSUABLE"},"race_loss":{"const":"NOT_ISSUED"},"network":{"const":"NONE"},"action":{"const":"NO_LIVE_ACTION"}}
    },
    "flop_testnet_readiness": {
      "type":"object","additionalProperties":false,"required":["schema","classification","yellow_paper","technocore","faucet","claim_endpoint","scoring","authority_manifest","network","action"],
      "properties":{"schema":{"const":"flop-testnet-readiness-v1"},"classification":{"const":"SAFE_PURE_OFFLINE_VALIDATOR"},"yellow_paper":{"const":"V0.5.0_OFFICIAL_DRAFT_UPDATED_2026-09-05"},"technocore":{"const":"0.13.0"},"faucet":{"const":"NOT_LIVE_CONFIRMED"},"claim_endpoint":{"const":"NONE_CONFIRMED"},"scoring":{"const":"UNRESOLVED"},"authority_manifest":{"const":"EMPTY_FAIL_CLOSED"},"network":{"const":"NONE"},"action":{"const":"NO_LIVE_ACTION"}}
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    }
  }
}
