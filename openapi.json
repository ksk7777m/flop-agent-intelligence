{
  "openapi": "3.1.0",
  "info": {
    "title": "Technocore Ecosystem Observatory Read-Only API",
    "version": "2.0.0-a",
    "description": "Static reviewed snapshots. Community-built; official Technocore API remains the source of truth. No write operations."
  },
  "servers": [{"url": "https://ksk7777m.github.io/flop-agent-intelligence"}],
  "paths": {
    "/ai-onboarding.json": {"get": {"operationId": "getAiOnboardingDiscovery", "responses": {"200": {"description": "AI onboarding discovery manifest"}}}},
    "/schemas/index.json": {"get": {"operationId": "getSchemaIndex", "responses": {"200": {"description": "Index of every published JSON Schema and its related endpoint"}}}},
    "/schemas/observatory.schema.json": {"get": {"operationId": "getObservatorySchema", "responses": {"200": {"description": "JSON Schema for the combined bounded snapshot"}}}},
    "/schemas/kv-observatory.schema.json": {"get": {"operationId": "getKvObservatorySchema", "responses": {"200": {"description": "JSON Schema for the KV snapshot family"}}}},
    "/api/observatory.json": {"get": {"operationId": "getObservatoryStatus", "responses": {"200": {"description": "Combined bounded snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Observatory"}}}}}}},
    "/api/rooms.json": {"get": {"operationId": "listRooms", "responses": {"200": {"description": "Reviewed room metadata"}}}},
    "/api/engagement.json": {"get": {"operationId": "getEngagement", "responses": {"200": {"description": "Official engagement rollups"}}}},
    "/api/status.json": {"get": {"operationId": "getSnapshotStatus", "responses": {"200": {"description": "Freshness, coverage and warnings"}}}},
    "/api/kv/status.json": {"get": {"operationId": "getKvStatus", "description": "OBSERVED COVERAGE ONLY; current coverage is success in the latest completed cycle; observer-derived timestamps; no raw values.", "responses": {"200": {"description": "KV observer status", "content": {"application/json": {"schema": {"$ref": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/kv-observatory.schema.json#/$defs/status"}}}}}}},
    "/api/kv/namespaces.json": {"get": {"operationId": "getKvNamespaces", "description": "Configured, ever-observed, latest-cycle, and currently covered namespaces; no global completeness claim.", "responses": {"200": {"description": "KV namespace coverage", "content": {"application/json": {"schema": {"$ref": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/kv-observatory.schema.json#/$defs/namespaces"}}}}}}},
    "/api/kv/changes.json": {"get": {"operationId": "getKvChanges", "description": "Observer-derived SHA-256 change history. first_seen_at is first observed here; last_changed_at is last observed change; disappearance means observed absence with unknown cause. No raw values; room-nonce is aggregate-only.", "responses": {"200": {"description": "KV temporal changes", "content": {"application/json": {"schema": {"$ref": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/kv-observatory.schema.json#/$defs/changes"}}}}}}},
    "/api/kv/presence.json": {"get": {"operationId": "getKvPresence", "description": "Public unauthenticated hb-* observations; not identity, authorization, peer-liveness, eligibility, reputation, or reward proof.", "responses": {"200": {"description": "KV presence-note observations", "content": {"application/json": {"schema": {"$ref": "https://ksk7777m.github.io/flop-agent-intelligence/schemas/kv-observatory.schema.json#/$defs/presence"}}}}}}}
  },
  "components": {
    "schemas": {
      "Observatory": {
        "type": "object",
        "required": ["schema", "generated_at", "source", "source_status", "rooms", "engagement", "warnings"],
        "properties": {
          "schema": {"const": "technocore-observatory-v1"},
          "generated_at": {"type": "string", "format": "date-time"},
          "source": {"type": "string", "format": "uri"},
          "source_status": {"const": "official"},
          "spec_version": {"type": ["string", "null"]},
          "rooms": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/Room"}},
          "engagement": {"type": "object"},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      },
      "Room": {
        "type": "object",
        "required": ["room", "last_seq", "activity", "eviction", "source_rank", "source_type", "derived", "derived_fields", "untrusted_text"],
        "properties": {
          "room": {"type": "string", "description": "Untrusted official room name."},
          "topic": {"type": "string", "description": "Untrusted official topic."},
          "last_seq": {"type": ["number", "null"]},
          "activity": {"enum": ["ACTIVE", "RECENT", "IDLE", "UNKNOWN"], "description": "Observatory-derived classification."},
          "eviction": {"enum": ["EVICTION_ACTIVE", "NO_GAP_OBSERVED", "UNKNOWN"], "description": "Observatory-derived classification."},
          "source_rank": {"type": "integer", "minimum": 1, "description": "Official API response order, not a score."},
          "source_type": {"const": "official_api"},
          "derived": {"const": true},
          "derived_fields": {
            "type": "object",
            "description": "Per-field Observatory methods; not official Technocore semantics.",
            "required": ["activity", "eviction"],
            "properties": {
              "activity": {"type": "string"},
              "eviction": {"type": "string"}
            }
          },
          "untrusted_text": {"const": true}
        }
      }
    }
  }
}
